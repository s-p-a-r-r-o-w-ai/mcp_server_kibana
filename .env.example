# Kibana Configuration
KIBANA_URL=https://your-kibana-instance.com
KIBANA_API_KEY=your-kibana-api-key-here

# MCP Server Authentication
# This key is required by clients to access the MCP server through Caddy
MCP_API_KEY=your-secret-api-key-here

# Logging
LOG_LEVEL=INFO

# Production HTTPS (optional)
# TLS_EMAIL=your-email@example.com
